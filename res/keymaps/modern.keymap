# SolveSpace NG "Modern" keymap: Blender's core (palette, pies, grab, sketch focus, numpad
# views) with the sketch, constraint and group keys of the industry CAD apps, Onshape's where
# they differ (owner review 4, 2026-10-17; docs/research/keymap-and-layout.md). Since the keymap
# pass after M3-M5 (2026-10-22, docs/research/keymap-pass.md) the qualifiers follow a grammar:
# the bare key is the command, Shift its counterpart (inverse, reverse, reference), Alt its
# variant (same family, another shape), Ctrl the document and the app; big families get pies.
# Kept against it: Shift+A, Shift+digits, Ctrl+numpad views, Shift+H hole, Shift+X split.
# Format: <command>: <chord>[, <chord>...]
# Command names are the stable ids from src/commandnames.cpp; "ui." names are UI actions
# (listed in src/ui/uiactions.cpp). While drawing or grabbing, digits, '.', '-', the numpad,
# Tab and Enter go to the typed-value fields first, so numpad views don't fire then.

ui.command-palette:     Space, F3
ui.toggle-menu-bar:     F10
ui.toggle-outliner:     O
ui.toggle-properties:   N
ui.toggle-problems:     F8
ui.pie-add:             Shift+A
ui.pie-view:            `
ui.pie-constrain:       K
ui.pie-joint:            J
ui.view-front:          Num1, Shift+1
ui.view-back:           Ctrl+Num1, Shift+2
ui.view-left:           Ctrl+Num3, Shift+3
ui.view-right:          Num3, Shift+4
ui.view-top:            Num7, Shift+5
ui.view-bottom:         Ctrl+Num7, Shift+6
ui.view-frame-selected: ., Num.
ui.hide:                Y
ui.unhide-all:          Shift+Y
ui.isolate:             Alt+Y
ui.toggle-sketch:       Tab
ui.smart-dimension:     D
ui.grab:                G

new:                    Ctrl+N
open:                   Ctrl+O
save:                   Ctrl+S
save-as:                Ctrl+Shift+S
exit:                   Ctrl+Q
undo:                   Ctrl+Z
redo:                   Ctrl+Shift+Z, Ctrl+Y
cut:                    Ctrl+X
copy:                   Ctrl+C
paste:                  Ctrl+V
paste-transformed:      Ctrl+Shift+V
delete:                 Delete, Backspace
select-all:             Ctrl+A
unselect-all:           Esc
select-edge-chain:      Ctrl+L
configuration:          Ctrl+,
regenerate-all:         F5

# Sketch (K1, K4)
datum-point:            P
line-segment:           L
rectangle:              R
circle:                 C
arc:                    A
tangent-arc:            Alt+A
cubic-spline:           S
toggle-construction:    X
split-curves:           Shift+X

# Constrain (K2, K3); D is the smart dimension above
constrain-reference-distance: Shift+D
constrain-angle:        Alt+D
constrain-horizontal:   H
constrain-vertical:     V
constrain-on-entity:    I
constrain-parallel:     B, T
constrain-perpendicular: Alt+B
constrain-equal:        Q
constrain-symmetric:    Alt+M
constrain-midpoint:     M
other-supplementary-angle: U

# Groups (K5)
group-extrude:          E
group-extrude-cut:      Shift+E
group-revolve:          Alt+E
group-fillet:           F
group-chamfer:          Alt+F
group-hole:             Shift+H
group-sketch-workplane: Alt+W
group-link:             Ctrl+I
part-new:               Ctrl+Shift+N
design-pose:            Shift+J

# View (K6)
nearest-iso:            Shift+7
align-to-workplane:     W
zoom-in:                Plus, =
zoom-out:               -
zoom-to-fit:            Home
perspective:            Num5
show-toolbar:           Ctrl+Shift+T
full-screen:            F11
