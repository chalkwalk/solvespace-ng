# SolveSpace NG "Modern" keymap (Blender-style). DRAFT: tuned during M1.
# Format: <command>: <chord>[, <chord>...]
# Command names are the stable ids from src/commandnames.cpp; "ui." names are UI actions
# (listed in src/ui/uiactions.cpp). While drawing or grabbing, digits, '.', '-', the numpad,
# Tab and Enter go to the typed-value fields first, so numpad views don't fire then.

ui.command-palette:     Space, F3
ui.toggle-menu-bar:     F10
ui.toggle-outliner:     O
ui.toggle-properties:   N
ui.toggle-problems:     Shift+P
ui.pie-add:             Shift+A
ui.pie-view:            `
ui.pie-constrain:       F
ui.view-front:          Num1
ui.view-back:           Ctrl+Num1
ui.view-right:          Num3
ui.view-left:           Ctrl+Num3
ui.view-top:            Num7
ui.view-bottom:         Ctrl+Num7
ui.view-frame-selected: ., Num.
ui.hide:                H
ui.unhide-all:          Alt+H
ui.isolate:             Shift+H
ui.toggle-sketch:       Tab
ui.smart-dimension:     D
ui.grab:                G

new:                    Ctrl+N
open:                   Ctrl+O
save:                   Ctrl+S
save-as:                Ctrl+Shift+S
exit:                   Ctrl+Q
undo:                   Ctrl+Z
redo:                   Ctrl+Shift+Z, Ctrl+Y
cut:                    Ctrl+X
copy:                   Ctrl+C
paste:                  Ctrl+V
paste-transformed:      Ctrl+Shift+V
delete:                 Delete, X
select-all:             A
unselect-all:           Alt+A, Esc
select-edge-chain:      Ctrl+L
configuration:          Ctrl+,
regenerate-all:         F5

datum-point:            P
line-segment:           L
construction-line-segment: Shift+L
rectangle:              B
circle:                 C
arc:                    Shift+C
tangent-arc:            Alt+C
cubic-spline:           Shift+B
ttf-text:               Shift+T
toggle-construction:    T
split-curves:           I

constrain-reference-distance: Shift+D
constrain-angle:        Alt+D

group-extrude:          E
group-revolve:          Shift+R
group-sketch-workplane: Shift+W
group-link:             Ctrl+I

zoom-in:                Plus, =
zoom-out:               -
zoom-to-fit:            Home
perspective:            Num5
show-grid:              Shift+G
show-property-browser:  Shift+N
show-toolbar:           Ctrl+Shift+T
full-screen:            F11
